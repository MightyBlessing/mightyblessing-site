# 사이트 URL — sitemap.xml, robots.txt, OG 메타에 반영됩니다.
NEXT_PUBLIC_SITE_URL=https://mightyblessing.com

# 헤더 "블로그" 메뉴 링크. 비워두면 https://blog.mightyblessing.com/ 으로 fallback.
NEXT_PUBLIC_BLOG_URL=

# Google Analytics 4 측정 ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-X195JMZNYZ

# Supabase 콘텐츠 스토리지
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_CONTENT=content-media
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_CONTENT=content-media

# Admin 인증 (Google 로그인)
# 운영에서는 아래 값을 모두 설정해야 합니다. 누락되면 관리자 접근이 차단됩니다.
# ADMIN_EMAILS: 관리자로 들일 Google 계정. 쉼표로 구분합니다. 목록에서 빼면 기존 로그인도 바로 끊깁니다.
# Google OAuth 클라이언트에는 `${NEXT_PUBLIC_SITE_URL}/api/admin/auth/google/callback`을 리디렉션 URI로 등록합니다.
# NODE_ENV=development에서는 Google 없이 '로컬 개발용으로 로그인'을 쓸 수 있습니다. 예제/개발 비밀값을 운영에 사용하지 마세요.
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub 연동 (배포 환경에서 admin 저장을 실제 저장소 커밋으로 연결할 때 사용)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# 문의 폼 메일 전송
# 둘 다 비워두면 문의 폼은 메일 작성창(mailto) fallback으로 동작합니다.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
INQUIRY_TO_EMAIL=contact@mightyblessing.com
